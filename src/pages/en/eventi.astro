---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Events — Società Filarmonica di Turriaco" lang="en" currentPage="eventi">
  <div class="page-header">
    <div class="container">
      <h1>Events and Concerts</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Upcoming Events</h2>
        <p>The concert and performance calendar</p>
      </div>
      <ul class="event-list">
        <li class="event-item">
          <div class="event-date-box"><span class="day">20</span><span class="month">Sep</span></div>
          <div class="event-info">
            <h3>ANBIMA Provincial Band Gathering</h3>
            <div class="event-meta">📍 Cormòns</div>
            <p>Gathering of the ANBIMA bands from the province of Gorizia</p>
          </div>
        </li>
        <li class="event-item">
          <div class="event-date-box"><span class="day">26</span><span class="month">Sep</span></div>
          <div class="event-info">
            <h3>47th ANBIMA FVG Regional Band Festival</h3>
            <div class="event-meta">📍 Maniago</div>
            <p>Gathering of the ANBIMA bands from the Friuli Venezia Giulia region, with 37 bands and around 1000 musicians</p>
          </div>
        </li>
        <li class="event-item">
          <div class="event-date-box"><span class="day">20</span><span class="month">Dec</span></div>
          <div class="event-info">
            <h3>Christmas Concert</h3>
            <div class="event-meta">📍 Turriaco</div>
             <p>The traditional concert closing the annual season </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Past Events -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <h2>Past Events</h2>
        <p>An archive of our past performances</p>
      </div>
      <div class="past-events">

        <h3 class="past-events-year">2026</h3>
        <ul class="past-events-list">
          <li><span class="past-events-date">01/05</span> Gradisca — May Day event</li>
          <li><span class="past-events-date">25/04</span> Turriaco — Liberation Day</li>
          <li><span class="past-events-date">05/04</span> Turriaco — Easter parade</li>
          <li><span class="past-events-date">08/02</span> Gorizia — Carnival parade</li>
          <li><span class="past-events-date">06/01</span> Fiumicello — Epiphany Concert</li>
          <li><span class="past-events-date">01/01</span> Turriaco — New Year's parade</li>
        </ul>

        <h3 class="past-events-year">2025</h3>
        <ul class="past-events-list">
          <li><span class="past-events-date">21/12</span> Turriaco — Christmas Concert</li>
