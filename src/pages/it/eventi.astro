---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Eventi — Società Filarmonica di Turriaco" lang="it" currentPage="eventi">
  <!-- Page Header -->
  <div class="page-header">
    <div class="container">
      <h1>Eventi e Concerti</h1>
    </div>
  </div>

  <!-- Prossimi Eventi -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Prossimi Appuntamenti</h2>
        <p>Il calendario dei concerti e delle esibizioni</p>
      </div>
      <ul class="event-list">

        <li class="event-item">
          <div class="event-date-box">
            <span class="day">20</span>
            <span class="month">Sept</span>
          </div>
          <div class="event-info">
            <h3>Raduno Provinciale ANBIMA</h3>
            <div class="event-meta">📍 Cormòns</div>
            <p>Raduno delle bande ANBIMA della provincia di Gorizia</p>
          </div>
        </li>

        <li class="event-item">
          <div class="event-date-box">
            <span class="day">26</span>
            <span class="month">Sept</span>
          </div>
          <div class="event-info">
            <h3>47a Rassegna Bandistica Regionale ANBIMA FVG</h3>
            <div class="event-meta">📍 Maniago</div>
            <p>Raduno delle bande ANBIMA della Regione Friuli Venezia Giulia con 37 bande musicali e circa 1000 musicisti </p>
          </div>
        </li>

        <li class="event-item">
          <div class="event-date-box">
            <span class="day">20</span>
            <span class="month">Dic</span>
          </div>
          <div class="event-info">
            <h3>Concerto di Natale</h3>
            <div class="event-meta">📍 Turriaco</div>
            <p>Il tradizionale concerto a chiusura dell'attività annuale</p>
          </div>
        </li>



      </ul>
    </div>
  </section>

  <!-- Eventi Anni Precedenti -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <h2>Eventi Anni Precedenti</h2>
        <p>Un archivio delle nostre esibizioni</p>
      </div>
      <div class="past-events">

        <h3 class="past-events-year">2026</h3>
